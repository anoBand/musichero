rules_version = '2';
// Music Hero: each signed-in user reads and writes only their own records (see js/cloud.js for the layout).
// Paste into Firebase console > Firestore Database > Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && request.resource.data.keys().hasOnly(['pref', 'prefAt', 'resetAt', 'updated']);

      // one answer; never changed after it is written
      match /events/{eventId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.id == eventId
          && request.resource.data.st == request.time
          && request.resource.data.keys().hasOnly(['id', 'at', 'k', 't', 'q', 'm', 'ok', 'r', 'x', 'g', 'st']);
        allow delete: if false;
      }

      // records a device had before the answer log
      match /bases/{dev} {
        allow read, write: if isOwner(uid);
      }
    }
  }
}
